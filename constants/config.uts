/**
 * Mint 本地/云端共用的配置。
 * 注意：AppSecret 只能保存在 uniCloud 云函数目录，绝不能放在这里。
 */
export const APP_NAME = 'Mint'
export const APP_VERSION = '1.0.0'
export const CLOUD_OBJECT_NAME = 'mint-core'
export const DEFAULT_ALERT_AT = 80

/**
 * 微信订阅消息模板 ID（非敏感）。
 * 申请模板后，把同一个 ID 填到这里和 uniCloud-alipay/cloudfunctions/mint-core/config.js。
 * 留空时，小程序会隐藏真实订阅能力，仅保留站内提醒。
 */
export const SUBSCRIBE_TEMPLATE_ID = ''

/** 订阅消息点击后跳转的小程序页面。 */
export const SUBSCRIBE_PAGE = 'pages/shell/shell?tab=budgets'

/** 演示版本号，界面上用于展示。 */
export const DEMO_TX_COUNT = 500
