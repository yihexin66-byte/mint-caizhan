export async function mockLogin(code : string) : Promise<LoginResult> {
	seed()
	const result : LoginResult = {
		token: 'demo-token-' + Date.now().toString(),
		user: { id: 'demo-user', nickname: 'Alex', avatar: '' },
		isNewUser: false
	}
	return result
}

export async function mockFetchSnapshot() : Promise<Snapshot> {
	seed()
	return {
		transactions: txStore.slice(0),
		debts: debtStore.slice(0),
		budgets: budgetStore.slice(0),
		settings: {
			locale: settingsStore.locale,
			baseCurrency: settingsStore.baseCurrency,
			rates: settingsStore.rates.slice(0),
			notifyWechat: settingsStore.notifyWechat
		}
	}
}

function findTx(id : string) : number {
	for (let i = 0; i < txStore.length; i++) {
		if (txStore[i].id == id) return i
	}
	return -1
}

export async function mockSaveTransaction(input : TransactionInput) : Promise<Transaction> {
	seed()
	const now = Date.now()
	if (input.id.length > 0) {
		const index = findTx(input.id)
		if (index >= 0) {
			const existing = txStore[index]
			if (existing.sourceDebtId.length > 0) {
				throw new Error('LINKED_TX')
			}
			const updated : Transaction = {
				id: existing.id,
				type: input.type,
				amount: input.amount,
				currency: input.currency,
				categoryId: input.categoryId,
				note: input.note,
				date: input.date,
				sourceDebtId: '',
				createdAt: existing.createdAt,
				updatedAt: now
			}
			txStore[index] = updated
			return updated
		}
	}
	const item : Transaction = {
		id: nextId('tx'),
		type: input.type,
		amount: input.amount,
		currency: input.currency,
		categoryId: input.categoryId,
		note: input.note,
		date: input.date,
		sourceDebtId: '',
		createdAt: now,
		updatedAt: now
	}
	txStore.push(item)
	return item
}

export async function mockDeleteTransaction(id : string) : Promise<boolean> {
	seed()
	const index = findTx(id)
	if (index >= 0) {
		if (txStore[index].sourceDebtId.length > 0) {
			throw new Error('LINKED_TX')
		}
		txStore.splice(index, 1)
	}
	return true
}

export async function mockSaveBudget(input : BudgetInput) : Promise<Budget> {
	seed()
	const now = Date.now()
	if (input.id.length > 0) {
		for (let i = 0; i < budgetStore.length; i++) {
			if (budgetStore[i].id == input.id) {
				const updated : Budget = {
					id: budgetStore[i].id,
					categoryId: input.categoryId,
					amount: input.amount,
					currency: input.currency,
					alertAt: input.alertAt,
					createdAt: budgetStore[i].createdAt,
					updatedAt: now
				}
				budgetStore[i] = updated
				return updated
			}
		}
	}
	for (let i = 0; i < budgetStore.length; i++) {
		if (budgetStore[i].categoryId == input.categoryId) {
			const updated : Budget = {
				id: budgetStore[i].id,
				categoryId: input.categoryId,
				amount: input.amount,
				currency: input.currency,
				alertAt: input.alertAt,
				createdAt: budgetStore[i].createdAt,
				updatedAt: now
			}
			budgetStore[i] = updated
			return updated
		}
	}
	const item : Budget = {
		id: nextId('budget'),
		categoryId: input.categoryId,
		amount: input.amount,
		currency: input.currency,
		alertAt: input.alertAt,
		createdAt: now,
		updatedAt: now
	}
	budgetStore.push(item)
	return item
}

export async function mockDeleteBudget(id : string) : Promise<boolean> {
	seed()
	for (let i = 0; i < budgetStore.length; i++) {
		if (budgetStore[i].id == id) {
			budgetStore.splice(i, 1)
			break
		}
	}
	return true
}

export async function mockSaveDebt(input : DebtInput) : Promise<Debt> {
	seed()
	const now = Date.now()
	if (input.id.length > 0) {
		for (let i = 0; i < debtStore.length; i++) {
			if (debtStore[i].id == input.id) {
				const existing = debtStore[i]
				if (existing.settled) {
					throw new Error('DEBT_SETTLED')
				}
				const updated : Debt = {
					id: existing.id,
					direction: input.direction,
					counterparty: input.counterparty,
					amount: input.amount,
					currency: input.currency,
					dueDate: input.dueDate,
					note: input.note,
					settled: false,
					settledAt: 0,
					linkedTxId: '',
					createdAt: existing.createdAt,
					updatedAt: now
				}
				debtStore[i] = updated
				return updated
			}
		}
	}
	const item : Debt = {
		id: nextId('debt'),
		direction: input.direction,
		counterparty: input.counterparty,
		amount: input.amount,
		currency: input.currency,
		dueDate: input.dueDate,
		note: input.note,
		settled: false,
		settledAt: 0,
		linkedTxId: '',
		createdAt: now,
		updatedAt: now
	}
	debtStore.push(item)
	return item
}

export async function mockSettleDebt(id : string) : Promise<SettleResult> {
	seed()
	for (let i = 0; i < debtStore.length; i++) {
		const debt = debtStore[i]
		if (debt.id != id) continue
		if (debt.settled) {
			throw new Error('DEBT_SETTLED')
		}
		const now = Date.now()
		const type = debt.direction == 'receivable' ? 'income' : 'expense'
		const categoryId = debt.direction == 'receivable' ? 'debt_receive' : 'debt_pay'
		const created = addTx(
			nextId('tx'),
			type,
			categoryId,
			debt.amount,
			debt.currency,
			now,
			(debt.direction == 'receivable' ? '收回 · ' : '结清 · ') + debt.counterparty,
			debt.id
		)
		const updated : Debt = {
			id: debt.id,
			direction: debt.direction,
			counterparty: debt.counterparty,
			amount: debt.amount,
			currency: debt.currency,
			dueDate: debt.dueDate,
			note: debt.note,
			settled: true,
			settledAt: now,
			linkedTxId: created.id,
			createdAt: debt.createdAt,
			updatedAt: now
		}
		debtStore[i] = updated
		return { debt: updated, transaction: created }
	}
	throw new Error('NOT_FOUND')
}

export async function mockDeleteDebt(id : string) : Promise<boolean> {
	seed()
	for (let i = 0; i < debtStore.length; i++) {
		if (debtStore[i].id == id) {
			if (debtStore[i].settled) {
				throw new Error('DEBT_SETTLED')
			}
			debtStore.splice(i, 1)
			break
		}
	}
	return true
}

export async function mockSaveSettings(settings : Settings) : Promise<Settings> {
	seed()
	settingsStore = {
		locale: settings.locale,
		baseCurrency: settings.baseCurrency,
		rates: settings.rates.slice(0),
		notifyWechat: settings.notifyWechat
	}
	return settings
}

export async function mockRegisterSubscription(templateId : string, accepted : boolean) : Promise<boolean> {
	seed()
	settingsStore.notifyWechat = accepted
	return accepted
}

export function mockSeedRates() : Array<Rate> {
	return copyDefaultRates()
}
