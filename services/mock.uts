let budgetStore : Array<Budget> = []
let settingsStore : Settings = {
	locale: 'zh',
	baseCurrency: 'CNY',
	rates: copyDefaultRates(),
	notifyWechat: false
}

function nextId(prefix : string) : string {
	seq++
	return prefix + '_' + Date.now().toString() + '_' + seq.toString()
}

function tsAt(monthOffset : number, day : number, hour : number) : number {
	const now = new Date()
	return new Date(now.getFullYear(), now.getMonth() - monthOffset, day, hour, 0, 0, 0).getTime()
}

function tsDaysAgo(days : number) : number {
	const now = new Date()
	return new Date(now.getFullYear(), now.getMonth(), now.getDate() - days, 12, 0, 0, 0).getTime()
}

function currentDay(day : number, hour : number) : number {
	const now = new Date()
	const safe = day > now.getDate() ? now.getDate() : day
	return new Date(now.getFullYear(), now.getMonth(), safe, hour, 0, 0, 0).getTime()
}

function addTx(
	id : string,
	type : string,
	categoryId : string,
	amount : number,
	currency : string,
	date : number,
	note : string,
	sourceDebtId : string
) : Transaction {
	const item : Transaction = {
		id: id,
		type: type,
		amount: amount,
		currency: currency,
		categoryId: categoryId,
		note: note,
		date: date,
		sourceDebtId: sourceDebtId,
		createdAt: date,
		updatedAt: date
	}
	txStore.push(item)
	return item
}

