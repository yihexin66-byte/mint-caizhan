export async function cloudSaveTransaction(input : TransactionInput) : Promise<Transaction> {
	try {
		const raw = await cloudObj.saveTransaction(session.token, input)
		return parseAs<Transaction>(raw)
	} catch (e) {
		throw new Error(cloudError(e))
	}
}

export async function cloudDeleteTransaction(id : string) : Promise<boolean> {
	try {
		const raw = await cloudObj.deleteTransaction(session.token, id)
		const data = raw as UTSJSONObject
		return data.getBoolean('ok') ?? false
	} catch (e) {
		throw new Error(cloudError(e))
	}
}

