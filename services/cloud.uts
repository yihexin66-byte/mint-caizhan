import {
	Budget,
	BudgetInput,
	Debt,
	DebtInput,
	LoginResult,
	RatesSnapshot,
	Settings,
	SettleResult,
	Snapshot,
	Transaction,
	TransactionInput,
	User
} from '@/types/models.uts'
import { CLOUD_OBJECT_NAME } from '@/constants/config.uts'
import { session } from '@/stores/session.uts'

const cloudObj : any = uniCloud.importObject(CLOUD_OBJECT_NAME, { customUI: true })

function parseAs<T>(raw : any) : T {
	return JSON.parse<T>(JSON.stringify(raw))!
}

function cloudError(error : any) : string {
	if (error == null) return 'UNKNOWN'
	try {
		const obj = error as UTSJSONObject
		const message = obj.getString('message')
		if (message != null && message.length > 0) return message
		const errMsg = obj.getString('errMsg')
		if (errMsg != null && errMsg.length > 0) return errMsg
	} catch (e) {
		// 网络层异常等并非 UTSJSONObject，读不到字段时退回字符串描述
	}
	return error.toString()
}

export async function cloudLogin(code : string) : Promise<LoginResult> {
	try {
		const raw = await cloudObj.login(code)
		return parseAs<LoginResult>(raw)
	} catch (e) {
		throw new Error(cloudError(e))
	}
}

export async function cloudUpdateProfile(nickname : string, avatar : string) : Promise<User> {
	try {
		const raw = await cloudObj.updateProfile(session.token, { nickname: nickname, avatar: avatar })
		return parseAs<User>(raw)
	} catch (e) {
		throw new Error(cloudError(e))
	}
}

