<template>
	<view class="month-switch">
		<view class="ms-btn" @click="emitPrev">
			<image class="ms-icon" src="/static/icons/ui-back-light.png" />
		</view>
		<text class="ms-label">{{ label }}</text>
		<view class="ms-btn" @click="emitNext">
			<image class="ms-icon" src="/static/icons/ui-right-light.png" />
		</view>
	</view>
</template>

<script setup lang="uts">
	defineOptions({
		styleIsolation: 'app'
	})

	defineProps({
		label: {
			type: String,
			default: ''
		}
	})

	const emit = defineEmits<{
		(e : 'prev') : void
		(e : 'next') : void
	}>()

	function emitPrev() : void {
		emit('prev')
	}

	function emitNext() : void {
		emit('next')
	}
</script>

<style>
	.month-switch {
		height: 34px;
		border-radius: 17px;
		background-color: rgba(255,255,255,0.045);
		background-image: linear-gradient(150deg, rgba(255,255,255,0.11) 0%, rgba(255,255,255,0.025) 100%);
		box-shadow: inset 0 0 0 1px rgba(255,255,255,0.09), inset 0 1px 0 rgba(255,255,255,0.16);
		flex-direction: row;
		align-items: center;
		align-self: flex-start;
		padding-left: 4px;
		padding-right: 4px;
	}

	.ms-btn {
		width: 28px;
		height: 28px;
		align-items: center;
		justify-content: center;
	}

	.ms-icon {
		width: 15px;
		height: 15px;
		opacity: 0.72;
	}

	.ms-label {
		font-size: 12px;
		font-weight: 650;
		color: #F2F6F1;
		padding-left: 2px;
		padding-right: 2px;
	}
</style>
