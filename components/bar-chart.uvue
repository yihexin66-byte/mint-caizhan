<template>
	<view class="bar-chart">
		<view class="bar-column" v-for="(item, index) in props.items" :key="index">
			<view class="bar-track">
				<view :class="item.highlight ? 'bar-fill bar-fill-active' : 'bar-fill'" :style="'height: ' + barHeight(item.value) + 'px; animation-delay: ' + (160 + index * 55) + 'ms'"></view>
			</view>
			<text :class="item.highlight ? 'bar-label bar-label-active' : 'bar-label'">{{ item.label }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, PropType } from 'vue'
	import { BarItem } from '@/types/models.uts'

	defineOptions({
		styleIsolation: 'app'
	})

	const props = defineProps({
		items: {
			type: Array as PropType<Array<BarItem>>,
			default: () : Array<BarItem> => [] as Array<BarItem>
		},
		height: {
			type: Number,
			default: 112
		}
	})

	const maxValue = computed(() : number => {
		let max = 1
		for (let i = 0; i < props.items.length; i++) {
			if (props.items[i].value > max) max = props.items[i].value
		}
		return max
	})

	function barHeight(value : number) : number {
		if (value <= 0) return 4
		const h = Math.round(value / maxValue.value * props.height)
		return h < 6 ? 6 : h
	}
</script>

<style>
	.bar-chart {
		height: 146px;
		flex-direction: row;
		align-items: flex-end;
	}

	.bar-column {
		flex: 1;
		align-items: center;
		flex-direction: column;
	}

	.bar-track {
		height: 118px;
		width: 100%;
		align-items: center;
		justify-content: flex-end;
		flex-direction: column;
	}

	@keyframes barRise {
		from {
			opacity: 0.2;
			transform: scaleY(0.04);
		}
		to {
			opacity: 1;
			transform: scaleY(1);
		}
	}

	.bar-fill {
		width: 18px;
		border-radius: 9px;
		background-color: rgba(240,160,106,0.24);
		background-image: linear-gradient(180deg, rgba(240,160,106,0.52) 0%, rgba(240,160,106,0.16) 100%);
		box-shadow: inset 0 1px 0 rgba(255,255,255,0.10);
		transform-origin: 50% 100%;
		animation-name: barRise;
		animation-duration: 520ms;
		animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
		animation-fill-mode: backwards;
	}

	.bar-fill-active {
		background-color: #A9EDCB;
		background-image: linear-gradient(180deg, #D6F8E6 0%, #A9EDCB 48%, #7BE7BF 100%);
		box-shadow: inset 0 1px 0 rgba(255,255,255,0.55), 0 0 18px rgba(123,231,191,0.28);
	}

	.bar-label {
		font-size: 10px;
		color: rgba(234,242,237,0.42);
		margin-top: 8px;
	}

	.bar-label-active {
		color: #F2F6F1;
		font-weight: 700;
	}
</style>
