<script setup lang="uts">
	import { t } from '@/i18n/index.uts'
	import { openTab } from '@/stores/ui.uts'

	defineOptions({
		styleIsolation: 'app'
	})

	const props = defineProps({
		active: {
			type: String,
			default: 'home'
		}
	})

	function switchTo(key : string) : void {
		openTab(key)
	}

	function addEntry() : void {
		uni.navigateTo({
			url: '/pages/record-edit/record-edit'
		})
	}
</script>

