<template>
	<view class="page">
		<aurora-bg level="mid" />
		<view class="status-spacer"></view>
		<view class="page-content">
			<view class="topbar enter-fade">
				<view class="row items-center">
					<view class="back-btn" @click="goBack">
						<image class="icon-18" src="/static/icons/ui-back-light.png" />
					</view>
					<view class="head-left">
						<text class="page-title">{{ t('rates.title') }}</text>
						<text class="page-sub">{{ t('rates.subtitle') }}</text>
					</view>
				</view>
				<view class="base-pill">
					<text class="base-pill-text">{{ prefs.baseCurrency }}</text>
				</view>
			</view>

			<view class="rate-hero enter-pop enter-d2">
				<view class="hero-orbit"></view>
				<view class="row justify-between items-center">
					<view class="row items-center">
						<view class="hero-tile">
							<text class="hero-tile-text">¥</text>
						</view>
						<view class="hero-main">
							<text class="hero-label">{{ t('rates.cnyBase') }}</text>
							<text class="hero-sub">{{ currencyName('CNY', prefs.locale) }} · CNY</text>
						</view>
					</view>
					<view class="hero-value-wrap">
						<text class="hero-value">1.00</text>
						<text class="hero-value-unit">{{ t('rates.unit') }}</text>
					</view>
				</view>
				<view class="hero-divider"></view>
				<view class="row justify-between items-center">
					<text class="hero-quote">{{ cnyQuote }}</text>
					<text class="hero-quote-label">{{ t('rates.fixed') }}</text>
				</view>
				<text class="hero-hint">{{ t('rates.hint') }}</text>
			</view>

			<view class="section-header enter-rise enter-d3">
				<view>
					<text class="section-title">{{ t('rates.current') }}</text>
					<text class="section-sub">{{ ratesUpdatedText }}</text>
				</view>
				<view class="caption-tag">
					<text class="caption-tag-text">CNY</text>
				</view>
			</view>

			<view class="card rates-card enter-rise enter-d4">
				<view v-for="(item, index) in rows" :key="item.code" class="rate-row">
					<view class="rate-tile">
						<text class="rate-symbol">{{ item.symbol }}</text>
					</view>
					<view class="grow rate-main">
						<view class="row items-center">
							<text class="rate-code">{{ item.code }}</text>
							<view v-if="prefs.baseCurrency == item.code" class="base-tag">
								<text class="base-tag-text">{{ t('settings.rateLocked') }}</text>
							</view>
						</view>
						<text class="rate-name">{{ item.name }}</text>
						<text class="rate-hint">{{ item.hint }}</text>
					</view>
					<view class="rate-input-box">
						<input
							class="rate-input"
							type="digit"
							:value="item.text"
							placeholder="0"
							placeholder-class="rate-placeholder"
							@input="onRateInput(index, $event)"
						/>
						<text class="rate-unit">{{ t('rates.unit') }}</text>
					</view>
				</view>
			</view>

			<view class="btn btn-mint save-btn" @click="saveRates">
				<image class="save-icon" src="/static/icons/ui-check.png" />
				<text class="btn-mint-text save-text">{{ t('rates.save') }}</text>
			</view>

			<view class="live-row" @click="refreshRates">
				<view :class="quoteLoading ? 'live-icon-wrap spinning' : 'live-icon-wrap'">
					<image class="live-icon" src="/static/icons/ui-swap-light.png" />
				</view>
				<view class="grow live-main">
					<text class="live-title">{{ quoteLoading ? t('rates.fetching') : t('rates.liveRefresh') }}</text>
					<text class="live-sub">{{ ratesUpdatedText }}</text>
				</view>
				<image class="live-chevron" src="/static/icons/ui-right-light.png" />
			</view>

			<view class="reset-row reset-row-secondary" @click="askReset">
				<text class="reset-text reset-text-secondary">{{ t('rates.resetDefault') }}</text>
			</view>

			<view class="rate-foot">
				<view class="dot dot-mint"></view>
				<text class="rate-foot-text">{{ t('rates.sourceNote') }}</text>
			</view>

			<view class="bottom-space"></view>
		</view>

		<view v-if="quoteOpen" class="modal-mask modal-mask-center">
			<view class="dialog quote-dialog">
				<text class="dialog-title">{{ t('rates.quoteTitle') }}</text>
				<text class="dialog-msg">{{ t('rates.quoteMsg') }}</text>
				<view class="quote-list">
					<view v-for="item in quoteRows" :key="item.code" class="quote-row">
						<text class="quote-code">{{ item.code }}</text>
						<text class="quote-value">{{ item.value }}</text>
						<text :class="item.deltaClass">{{ item.delta }}</text>
					</view>
				</view>
				<text class="quote-source">{{ quoteSourceText }}</text>
				<view class="row dialog-actions">
					<view class="dialog-btn dialog-btn-ghost" @click="closeQuote">
						<text class="dialog-btn-ghost-text">{{ t('rates.later') }}</text>
					</view>
					<view class="dialog-btn dialog-btn-mint" @click="applyQuote">
						<text class="dialog-btn-mint-text">{{ t('rates.apply') }}</text>
					</view>
				</view>
			</view>
		</view>

		<view v-if="resetOpen" class="modal-mask modal-mask-center">
			<view class="dialog">
				<text class="dialog-title">{{ t('rates.resetTitle') }}</text>
				<text class="dialog-msg">{{ t('rates.resetMsg') }}</text>
				<view class="row dialog-actions">
					<view class="dialog-btn dialog-btn-ghost" @click="closeReset">
						<text class="dialog-btn-ghost-text">{{ t('common.cancel') }}</text>
					</view>
					<view class="dialog-btn dialog-btn-dark" @click="confirmReset">
						<text class="dialog-btn-dark-text">{{ t('rates.reset') }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import AuroraBg from '@/components/aurora-bg.uvue'
	import { t } from '@/i18n/index.uts'
	import { prefs, setRates } from '@/stores/prefs.uts'
	import { session } from '@/stores/session.uts'
	import { ensureLoaded, syncSettings } from '@/stores/ledger.uts'
	import { CURRENCIES, copyDefaultRates, currencyName } from '@/constants/currencies.uts'
	import { parseAmount, rateOf, trimAmountInput } from '@/utils/money.uts'
	import { groupDateKey } from '@/utils/date.uts'
	import { cloudLatestRates } from '@/services/cloud.uts'
	import { Rate, RatesSnapshot } from '@/types/models.uts'

	const META_KEY = 'mint_rates_meta'
	const CHECK_KEY = 'mint_rates_check_day'

	type RateRow = {
		code : string
		name : string
		symbol : string
		text : string
		hint : string
	}

	type QuoteRow = {
		code : string
		value : string
		delta : string
		deltaClass : string
	}

	type RatesMeta = {
		source : string
		date : string
	}

	function formatRate(value : number) : string {
		const fixed = value.toFixed(4)
		let end = fixed.length
		while (end > 0 && fixed.charAt(end - 1) == '0') {
			end--
		}
		if (end > 0 && fixed.charAt(end - 1) == '.') {
			end--
		}
		return fixed.substring(0, end)
	}

	function hintFor(code : string, text : string) : string {
		const value = parseAmount(text)
		if (value <= 0) return t('rates.invalid')
		return '1 ' + code + ' ≈ ' + formatRate(value) + ' ' + t('rates.unit')
	}

	function buildRows() : Array<RateRow> {
		const result : Array<RateRow> = []
		for (let i = 0; i < CURRENCIES.length; i++) {
			const item = CURRENCIES[i]
			if (item.code == 'CNY') continue
			const text = formatRate(rateOf(item.code, prefs.rates))
			result.push({
				code: item.code,
				name: currencyName(item.code, prefs.locale),
				symbol: item.symbol,
				text: text,
				hint: hintFor(item.code, text)
			})
		}
		return result
	}

	const rows = ref<Array<RateRow>>(buildRows())
	const resetOpen = ref(false)
	const quoteOpen = ref(false)
	const quoteLoading = ref(false)
	const quoteRows = ref<Array<QuoteRow>>([])
	const quoteRates = ref<Array<Rate>>([])
	const quoteSource = ref('')
	const quoteDate = ref('')
	const updatedMeta = ref<RatesMeta>({ source: '', date: '' })

	function loadMeta() : void {
		const raw = uni.getStorageSync(META_KEY)
		if (typeof raw == 'string') {
			const value = raw as string
			if (value.length > 0) {
				const parsed = JSON.parse<RatesMeta>(value)
				if (parsed != null) {
					updatedMeta.value = parsed
				}
			}
		}
	}

	function clearMeta() : void {
		updatedMeta.value = { source: '', date: '' }
		uni.removeStorageSync(META_KEY)
	}

	loadMeta()

	onPageShow(() => {
		if (!session.isLoggedIn) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return
		}
		ensureLoaded()
		maybeAutoRefresh()
	})

	const cnyQuote = computed(() : string => {
		return '1 CNY = 1 ' + t('rates.unit')
	})

	const ratesUpdatedText = computed(() : string => {
		const meta = updatedMeta.value
		if (meta.source.length == 0) return t('rates.updatedLocal')
		if (meta.date.length == 0) return meta.source
		return meta.source + ' · ' + meta.date
	})

	const quoteSourceText = computed(() : string => {
		if (quoteSource.value.length == 0) return ''
		if (quoteDate.value.length == 0) return quoteSource.value
		return quoteSource.value + ' · ' + quoteDate.value
	})

	function buildQuoteRows(input : Array<Rate>) : Array<QuoteRow> {
		const result : Array<QuoteRow> = []
		for (let i = 0; i < input.length; i++) {
			const item = input[i]
			if (item.currency == 'CNY') continue
			const previous = rateOf(item.currency, prefs.rates)
			let percent = 0
			if (previous > 0) {
				percent = ((item.rateCny - previous) / previous) * 100
			}
			let deltaClass = 'quote-delta quote-flat'
			if (percent > 0.005) deltaClass = 'quote-delta quote-up'
			if (percent < -0.005) deltaClass = 'quote-delta quote-down'
			const sign = percent > 0.005 ? '+' : ''
			result.push({
				code: item.currency,
				value: formatRate(item.rateCny),
				delta: sign + percent.toFixed(2) + '%',
				deltaClass: deltaClass
			})
		}
		return result
	}

	function openQuote(snapshot : RatesSnapshot) : void {
		quoteRates.value = snapshot.rates
		quoteSource.value = snapshot.source
		quoteDate.value = snapshot.date
		quoteRows.value = buildQuoteRows(snapshot.rates)
		quoteOpen.value = true
	}

	async function fetchRates(manual : boolean) : Promise<void> {
		if (quoteLoading.value) return
		if (session.token == 'demo-token') {
			if (manual) {
				uni.showToast({
					title: t('rates.demoUnavailable'),
					icon: 'none'
				})
			}
			return
		}
		quoteLoading.value = true
		if (manual) {
			uni.showLoading({
				title: t('rates.fetching'),
				mask: true
			})
		}
		let ok = false
		let snapshot : RatesSnapshot = { source: '', date: '', fetchedAt: 0, rates: [] }
		try {
			snapshot = await cloudLatestRates()
			uni.setStorageSync(CHECK_KEY, groupDateKey(Date.now()))
			ok = true
		} catch (e) {
			ok = false
		}
		if (manual) {
			uni.hideLoading()
		}
		quoteLoading.value = false
		if (ok) {
			openQuote(snapshot)
		} else if (manual) {
			uni.showToast({
				title: t('rates.fetchFailed'),
				icon: 'none'
			})
		}
	}

	function refreshRates() : void {
		fetchRates(true)
	}

	function maybeAutoRefresh() : void {
		const raw = uni.getStorageSync(CHECK_KEY)
		if (typeof raw == 'string') {
			const value = raw as string
			if (value == groupDateKey(Date.now())) return
		}
		fetchRates(false)
	}

	function closeQuote() : void {
		quoteOpen.value = false
	}

	async function applyQuote() : Promise<void> {
		if (quoteRates.value.length == 0) return
		quoteOpen.value = false
		setRates(quoteRates.value)
		rows.value = buildRows()
		updatedMeta.value = { source: quoteSource.value, date: quoteDate.value }
		uni.setStorageSync(META_KEY, JSON.stringify(updatedMeta.value))
		uni.setStorageSync(CHECK_KEY, groupDateKey(Date.now()))
		await syncSettings()
		uni.showToast({
			title: t('rates.applied'),
			icon: 'success'
		})
	}

	function goBack() : void {
		uni.navigateBack()
	}

	function onRateInput(index : number, event : UniInputEvent) : void {
		const text = trimAmountInput(event.detail.value)
		rows.value[index].text = text
		rows.value[index].hint = hintFor(rows.value[index].code, text)
	}

	async function saveRates() : Promise<void> {
		const next : Array<Rate> = []
		next.push({ currency: 'CNY', rateCny: 1 })
		for (let i = 0; i < rows.value.length; i++) {
			const row = rows.value[i]
			const value = parseAmount(row.text)
			if (value <= 0) {
				uni.showToast({
					title: t('rates.invalid'),
					icon: 'none'
				})
				return
			}
			next.push({ currency: row.code, rateCny: value })
		}
		setRates(next)
		clearMeta()
		await syncSettings()
		uni.showToast({
			title: t('rates.saved'),
			icon: 'success'
		})
	}

	function askReset() : void {
		resetOpen.value = true
	}

	function closeReset() : void {
		resetOpen.value = false
	}

	function confirmReset() : void {
		resetOpen.value = false
		setRates(copyDefaultRates())
		clearMeta()
		rows.value = buildRows()
		syncSettings()
		uni.showToast({
			title: t('rates.resetDone'),
			icon: 'none'
		})
	}
</script>

