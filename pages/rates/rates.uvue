	}

	.live-row {
		height: 60px;
		margin-top: 12px;
		border-radius: 16px;
		background-color: rgba(123,231,191,0.07);
		flex-direction: row;
		align-items: center;
		padding-left: 13px;
		padding-right: 14px;
		box-shadow: inset 0 0 0 1px rgba(169,237,203,0.14), inset 0 1px 0 rgba(255,255,255,0.10);
	}

