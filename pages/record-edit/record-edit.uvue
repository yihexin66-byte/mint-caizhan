<template>
	<view class="page">
		<aurora-bg level="low" />
		<view class="status-spacer"></view>
		<view class="page-content">
			<view class="topbar enter-fade">
				<view class="icon-btn" @click="goBack">
					<image class="icon-18" src="/static/icons/ui-back-light.png" />
				</view>
				<view class="head-center">
					<text class="page-title">{{ pageTitle }}</text>
					<text class="page-sub">{{ t('home.subtitle') }}</text>
				</view>
				<view v-if="isEditing && !linked" class="icon-btn" @click="askDelete">
					<image class="icon-18" src="/static/icons/ui-trash-light.png" />
				</view>
				<view v-else class="icon-btn-space"></view>
			</view>

			<view v-if="linked" class="linked-banner enter-rise enter-d1">
				<view class="linked-icon">
					<image class="icon-18" src="/static/icons/ui-shield-light.png" />
				</view>
				<view class="grow">
					<text class="linked-title">{{ t('recordEdit.linkedTitle') }}</text>
					<text class="linked-sub">{{ t('recordEdit.linkedHint') }}</text>
				</view>
			</view>

			<view class="type-switch enter-rise enter-d1">
				<view :class="type == 'expense' ? 'type-item type-item-active' : 'type-item'" @click="setType('expense')">
					<view :class="type == 'expense' ? 'dot dot-orange' : 'dot dot-muted'"></view>
					<text :class="type == 'expense' ? 'type-text type-text-active' : 'type-text'">{{ t('recordEdit.expense') }}</text>
				</view>
				<view :class="type == 'income' ? 'type-item type-item-active' : 'type-item'" @click="setType('income')">
					<view :class="type == 'income' ? 'dot dot-mint' : 'dot dot-muted'"></view>
					<text :class="type == 'income' ? 'type-text type-text-active' : 'type-text'">{{ t('recordEdit.income') }}</text>
				</view>
			</view>

			<view class="amount-card enter-pop enter-d2">
				<view class="amount-orbit"></view>
				<view class="row justify-between items-center">
					<text class="amount-label">{{ t('recordEdit.amount') }}</text>
					<view class="currency-chip" @click="openCurrency">
						<text class="currency-chip-code">{{ currency }}</text>
						<image class="currency-chip-icon" src="/static/icons/ui-down.png" />
					</view>
				</view>
				<view class="row items-end amount-line">
					<text class="amount-symbol">{{ currencySymbol }}</text>
					<input
						class="amount-input"
						type="digit"
						:value="amountText"
						:disabled="linked"
						placeholder="0"
						placeholder-class="amount-placeholder"
						@input="onAmountInput"
					/>
				</view>
				<text class="converted-hint">{{ convertedHint }}</text>
			</view>

			<view class="section-head enter-rise enter-d3">
				<text class="section-title">{{ t('recordEdit.category') }}</text>
				<text class="section-value">{{ selectedCategoryName }}</text>
			</view>
			<view class="card cat-card enter-rise enter-d3">
				<view class="row wrap">
					<view v-for="cat in categories" :key="cat.id" class="cat-item" @click="chooseCategory(cat.id)">
						<view class="cat-tile-wrap">
							<view class="cat-tile" :style="'background-color: ' + cat.color + '2E'">
								<image class="cat-icon" :src="categoryIconPath(cat.id)" />
							</view>
							<view v-if="categoryId == cat.id" class="cat-check">
								<image class="cat-check-icon" src="/static/icons/ui-check.png" />
							</view>
						</view>
						<text :class="categoryId == cat.id ? 'cat-name cat-name-active' : 'cat-name'">{{ categoryName(cat.id, prefs.locale) }}</text>
					</view>
				</view>
			</view>

			<view class="section-head enter-rise enter-d3">
				<text class="section-title">{{ t('common.note') }}</text>
			</view>
			<view class="card detail-card enter-rise enter-d4">
				<picker class="detail-picker" mode="date" :value="dateValue" @change="onDateChange">
					<view class="detail-row">
						<view class="detail-icon">
							<image class="icon-18" src="/static/icons/ui-calendar-light.png" />
						</view>
						<text class="detail-label">{{ t('common.date') }}</text>
						<text class="detail-value">{{ dateDisplay }}</text>
						<image class="detail-arrow" src="/static/icons/ui-right-light.png" />
					</view>
				</picker>
				<view class="divider"></view>
				<view class="detail-row">
					<view class="detail-icon">
						<image class="icon-18" src="/static/icons/ui-edit-light.png" />
					</view>
					<text class="detail-label">{{ t('common.note') }}</text>
					<input
						class="detail-input"
						:value="note"
						:disabled="linked"
						:placeholder="t('recordEdit.notePh')"
						placeholder-class="detail-placeholder"
						@input="onNoteInput"
					/>
				</view>
			</view>

			<view v-if="!linked" :class="saving ? 'btn btn-mint save-btn save-btn-busy enter-rise enter-d5' : 'btn btn-mint save-btn enter-rise enter-d5'" hover-class="pressed" @click="save">
				<image v-if="!saving" class="save-icon" src="/static/icons/ui-check.png" />
				<text class="btn-mint-text">{{ saving ? t('common.loading') : t('recordEdit.save') }}</text>
			</view>

			<view v-if="isEditing && !linked" class="delete-row" @click="askDelete">
				<image class="delete-icon" src="/static/icons/ui-trash-light.png" />
				<text class="delete-text">{{ t('recordEdit.delete') }}</text>
			</view>

			<view class="bottom-space"></view>
		</view>

		<view v-if="currencyOpen" class="modal-mask" @click="closeCurrency">
			<view class="sheet currency-sheet" @click.stop>
				<view class="sheet-handle"></view>
				<text class="sheet-title">{{ t('sheet.currencyTitle') }}</text>
				<view v-for="item in currencies" :key="item.code" class="currency-row" @click="pickCurrency(item.code)">
					<view class="currency-badge">
						<text class="currency-badge-symbol">{{ item.symbol }}</text>
					</view>
					<view class="grow currency-info">
						<text class="currency-name">{{ currencyName(item.code, prefs.locale) }}</text>
						<text class="currency-code">{{ item.code }}</text>
					</view>
					<view v-if="currency == item.code" class="currency-check">
						<image class="currency-check-icon" src="/static/icons/ui-check.png" />
					</view>
				</view>
			</view>
		</view>

		<view v-if="deleteOpen" class="modal-mask modal-mask-center">
			<view class="dialog">
				<view class="dialog-icon">
					<image class="icon-20" src="/static/icons/ui-trash-light.png" />
				</view>
				<text class="dialog-title">{{ t('recordEdit.deleteTitle') }}</text>
				<text class="dialog-msg">{{ t('recordEdit.deleteMsg') }}</text>
				<view class="row dialog-actions">
					<view class="dialog-btn dialog-btn-ghost" @click="closeDelete">
						<text class="dialog-btn-ghost-text">{{ t('common.cancel') }}</text>
					</view>
					<view class="dialog-btn dialog-btn-danger" @click="confirmDelete">
						<text class="dialog-btn-danger-text">{{ t('common.delete') }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref, watch } from 'vue'
	import AuroraBg from '@/components/aurora-bg.uvue'
	import { t } from '@/i18n/index.uts'
	import { prefs } from '@/stores/prefs.uts'
	import { session } from '@/stores/session.uts'
	import { ledger, ensureLoaded, findTransaction, saveTx, removeTx } from '@/stores/ledger.uts'
	import { CategoryDef, CurrencyDef, Transaction, TransactionInput } from '@/types/models.uts'
	import { CURRENCIES, currencyByCode, currencyName } from '@/constants/currencies.uts'
	import { categoriesOf, categoryName, categoryIconPath } from '@/constants/categories.uts'
	import { dateLabelWithWeek, nextDaysTs, parseDateInput, toDateInput } from '@/utils/date.uts'
	import { convertAmount, formatCurrency, parseAmount, trimAmountInput } from '@/utils/money.uts'

	const type = ref('expense')
	const amountText = ref('')
	const currency = ref(prefs.baseCurrency)
	const categoryId = ref(categoriesOf('expense')[0].id)
	const dateTs = ref(nextDaysTs(0))
	const note = ref('')
	const saving = ref(false)
	const currencyOpen = ref(false)
	const deleteOpen = ref(false)
	const editId = ref('')
	const hydrated = ref(false)

	const currencies = computed<Array<CurrencyDef>>(() => {
		return CURRENCIES
	})

	const categories = computed<Array<CategoryDef>>(() => {
		return categoriesOf(type.value)
	})

	const isEditing = computed(() : boolean => {
		return editId.value.length > 0
	})

	const linked = computed(() : boolean => {
		if (editId.value.length == 0) return false
		const tx = findTransaction(editId.value)
		if (tx == null) return false
		return tx.sourceDebtId.length > 0
	})

	const pageTitle = computed(() : string => {
		return isEditing.value ? t('recordEdit.editTitle') : t('recordEdit.newTitle')
	})

	const selectedCategoryName = computed(() : string => {
		return categoryName(categoryId.value, prefs.locale)
	})

	const currencySymbol = computed(() : string => {
		return currencyByCode(currency.value).symbol
	})

	const dateValue = computed(() : string => {
		return toDateInput(dateTs.value)
	})

	const dateDisplay = computed(() : string => {
		return dateLabelWithWeek(dateTs.value, prefs.locale)
	})

	const convertedHint = computed(() : string => {
		const amount = parseAmount(amountText.value)
		if (amount <= 0) return t('recordEdit.currencyHint')
		if (currency.value == prefs.baseCurrency) return t('recordEdit.currencyHint')
		const converted = convertAmount(amount, currency.value, prefs.baseCurrency, prefs.rates)
		return t('recordEdit.converted') + ' ' + formatCurrency(converted, prefs.baseCurrency, prefs.locale) + ' ' + prefs.baseCurrency
	})

	onLoad((options : OnLoadOptions) => {
		const raw = options.getString('id')
		if (raw != null && raw.length > 0) {
			editId.value = raw
		}
	})

	onPageShow(() => {
		if (!session.isLoggedIn) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return
		}
		ensureLoaded()
		hydrate()
	})

	onMounted(() => {
		hydrate()
	})

	watch(() => ledger.loaded, (loaded : boolean) => {
		if (loaded) hydrate()
	})

	function hydrate() : void {
		if (hydrated.value) return
		if (editId.value.length == 0) {
			hydrated.value = true
			return
		}
		if (!ledger.loaded) return
		const tx = findTransaction(editId.value)
		if (tx != null) {
			type.value = tx.type
			amountText.value = trimAmountInput(tx.amount.toString())
			currency.value = tx.currency
			categoryId.value = tx.categoryId
			dateTs.value = tx.date
			note.value = tx.note
		} else {
			uni.showToast({
				title: t('common.networkError'),
				icon: 'none'
			})
		}
		hydrated.value = true
	}

	function setType(next : string) : void {
		if (linked.value) return
		if (type.value == next) return
		type.value = next
		categoryId.value = categoriesOf(next)[0].id
	}

	function chooseCategory(id : string) : void {
		if (linked.value) return
		categoryId.value = id
	}

	function onAmountInput(event : UniInputEvent) : void {
		amountText.value = trimAmountInput(event.detail.value)
	}

	function onNoteInput(event : UniInputEvent) : void {
		note.value = event.detail.value
	}

	function onDateChange(event : UniPickerChangeEvent) : void {
		dateTs.value = parseDateInput(event.detail.value as string)
	}

	function openCurrency() : void {
		if (linked.value) return
		currencyOpen.value = true
	}

	function closeCurrency() : void {
		currencyOpen.value = false
	}

	function pickCurrency(code : string) : void {
		currency.value = code
		currencyOpen.value = false
	}

	function askDelete() : void {
		deleteOpen.value = true
	}

	function closeDelete() : void {
		deleteOpen.value = false
	}

	async function save() : Promise<void> {
		if (saving.value || linked.value) return
		const amount = parseAmount(amountText.value)
		if (amount <= 0) {
			uni.showToast({
				title: t('recordEdit.validationAmount'),
				icon: 'none'
			})
			return
		}
		saving.value = true
		const input : TransactionInput = {
			id: editId.value,
			type: type.value,
			amount: amount,
			currency: currency.value,
			categoryId: categoryId.value,
			note: note.value,
			date: dateTs.value
		}
		try {
			await saveTx(input)
			uni.showToast({
				title: t('recordEdit.saved'),
				icon: 'success'
			})
			setTimeout(() => {
				uni.navigateBack({
					delta: 1
				})
			}, 380)
		} catch (e) {
			saving.value = false
			uni.showModal({
				content: t('common.saveFailed'),
				showCancel: false
			})
		}
	}

	async function confirmDelete() : Promise<void> {
		deleteOpen.value = false
		const id = editId.value
		if (id.length == 0) return
		try {
			await removeTx(id)
			uni.navigateBack({
				delta: 1
			})
		} catch (e) {
			uni.showModal({
				content: t('common.deleteFailed'),
				showCancel: false
			})
		}
	}

	function goBack() : void {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/shell/shell'
				})
			}
		})
	}
</script>

