<template>
	<view class="page">
		<aurora-bg level="mid" />
		<view class="status-spacer"></view>
		<view class="page-content">
			<view class="topbar enter-fade">
				<view class="icon-btn" @click="goBack">
					<image class="icon-18" src="/static/icons/ui-back-light.png" />
				</view>
				<view class="head-left">
					<text class="page-title">{{ t('debts.title') }}</text>
					<text class="page-sub">{{ t('debts.subtitle') }}</text>
				</view>
				<view class="quick-add" @click="addDebt">
					<image class="quick-add-icon" src="/static/icons/ui-plus-ink.png" />
					<text class="quick-add-text">{{ t('debts.add') }}</text>
				</view>
			</view>

			<view v-if="!ledger.loaded" class="loading-wrap">
				<image class="logo-40" src="/static/icons/logo-light.png" />
				<text class="loading-text">{{ ledger.error.length > 0 ? t('common.networkError') : t('common.loading') }}</text>
			</view>

			<view v-else>
				<view class="hero-card enter-pop enter-d2">
					<view class="hero-orbit"></view>
					<view class="row justify-between items-center">
						<view class="row items-center">
							<view class="hero-dot"></view>
							<text class="hero-label">{{ t('debts.net') }}</text>
						</view>
						<view class="hero-count">
							<text class="hero-count-text">{{ openCountText }}</text>
						</view>
					</view>
					<text class="hero-amount">{{ netText }}</text>

					<view class="row hero-stats">
						<view class="hero-stat">
							<view class="row items-center">
								<view class="dot dot-mint"></view>
								<text class="hero-stat-label">{{ t('debts.receivable') }}</text>
							</view>
							<text class="hero-stat-value">{{ receivableText }}</text>
							<text class="hero-stat-sub">{{ receivableCountText }}</text>
						</view>
						<view class="hero-stat hero-stat-right">
							<view class="row items-center">
								<view class="dot dot-orange"></view>
								<text class="hero-stat-label">{{ t('debts.payable') }}</text>
							</view>
							<text class="hero-stat-value">{{ payableText }}</text>
							<text class="hero-stat-sub">{{ payableCountText }}</text>
						</view>
					</view>
				</view>

				<view class="filter-row enter-rise enter-d3">
					<view :class="filter == 'active' ? 'chip chip-active filter-chip' : 'chip filter-chip'" @click="setFilter('active')">
						<text :class="filter == 'active' ? 'chip-text chip-text-active' : 'chip-text'">{{ t('debts.active') }}</text>
					</view>
					<view :class="filter == 'settled' ? 'chip chip-active filter-chip' : 'chip filter-chip'" @click="setFilter('settled')">
						<text :class="filter == 'settled' ? 'chip-text chip-text-active' : 'chip-text'">{{ t('debts.settled') }}</text>
					</view>
				</view>

				<view v-if="filter == 'active'" class="enter-rise enter-d4">
					<view v-if="activeViews.length == 0" class="mt-14">
						<empty-state
							:title="t('debts.empty')"
							:subtitle="t('debts.emptySub')"
							:action="t('debts.add')"
							icon="/static/icons/logo-light.png"
							@action="addDebt"
						/>
					</view>
					<view v-else>
						<view v-for="item in activeViews" :key="item.id" class="card debt-item" @click="openEdit(item.id)">
							<view class="row justify-between items-center">
								<view :class="item.direction == 'receivable' ? 'dir-chip dir-chip-in' : 'dir-chip dir-chip-out'">
									<text :class="item.direction == 'receivable' ? 'dir-chip-text dir-chip-text-in' : 'dir-chip-text dir-chip-text-out'">{{ item.dirLabel }}</text>
								</view>
								<text :class="item.overdue ? 'due-text due-text-over' : 'due-text'">{{ item.dueText }}</text>
							</view>

							<view class="row items-end debt-main">
								<view class="grow">
									<text class="debt-name">{{ item.counterparty }}</text>
									<text v-if="item.note.length > 0" class="debt-note">{{ item.note }}</text>
								</view>
								<text class="debt-amount">{{ item.amountText }}</text>
							</view>

							<view class="debt-line"></view>
							<view class="row justify-between items-center">
								<view class="row items-center">
									<image class="debt-mini-icon" src="/static/icons/ui-edit-light.png" />
									<text class="debt-edit-hint">{{ t('common.edit') }}</text>
								</view>
								<view class="settle-btn" @click.stop="askSettle(item.id)">
									<image class="settle-icon" src="/static/icons/ui-check-light.png" />
									<text class="settle-text">{{ t('debts.settle') }}</text>
								</view>
							</view>
						</view>
					</view>
				</view>

				<view v-else class="enter-rise enter-d4">
					<view v-if="settledViews.length == 0" class="mt-14">
						<empty-state
							:title="t('debts.noSettled')"
							:subtitle="t('debts.subtitle')"
							icon="/static/icons/logo-light.png"
						/>
					</view>
					<view v-else>
						<view v-for="item in settledViews" :key="item.id" class="card settled-item">
							<view class="row justify-between items-center">
								<view class="row items-center">
									<view class="settled-check">
										<image class="settled-check-icon" src="/static/icons/ui-check-white.png" />
									</view>
									<view class="settled-main">
										<text class="settled-name">{{ item.counterparty }}</text>
										<text class="settled-sub">{{ item.settledText }}</text>
									</view>
								</view>
								<text class="settled-amount">{{ item.amountText }}</text>
							</view>
							<view class="settled-foot">
								<view class="row items-center">
									<view class="dot dot-mint"></view>
									<text class="settled-linked">{{ item.linkedText }}</text>
								</view>
								<text class="settled-tag">{{ item.dirLabel }}</text>
							</view>
						</view>
					</view>
				</view>

				<view class="bottom-space"></view>
			</view>
		</view>

		<view v-if="settleTargetId.length > 0" class="modal-mask modal-mask-center">
			<view class="dialog">
				<view class="dialog-icon">
					<image class="icon-20" src="/static/icons/ui-swap-light.png" />
				</view>
				<text class="dialog-title">{{ t('debts.settleTitle') }}</text>
				<text class="dialog-msg">{{ settleMessage }}</text>
				<view class="settle-summary">
					<text class="settle-summary-name">{{ settleName }}</text>
					<text class="settle-summary-amount">{{ settleAmountText }}</text>
				</view>
				<view class="row dialog-actions">
					<view class="dialog-btn dialog-btn-ghost" @click="closeSettle">
						<text class="dialog-btn-ghost-text">{{ t('common.cancel') }}</text>
					</view>
					<view class="dialog-btn dialog-btn-mint" @click="confirmSettle">
						<text class="dialog-btn-mint-text">{{ t('debts.settle') }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import AuroraBg from '@/components/aurora-bg.uvue'
	import EmptyState from '@/components/empty-state.uvue'
	import { t } from '@/i18n/index.uts'
	import { prefs } from '@/stores/prefs.uts'
	import { session } from '@/stores/session.uts'
	import { ledger, ensureLoaded, findDebt, settleDebtItem } from '@/stores/ledger.uts'
	import { debtSummary, openDebtCount } from '@/utils/stats.uts'
	import { dateLabel, dueLabel, isOverdue } from '@/utils/date.uts'
	import { formatCurrency } from '@/utils/money.uts'
	import { Debt } from '@/types/models.uts'

	type DebtView = {
		id : string
		direction : string
		counterparty : string
		note : string
		amountText : string
		dirLabel : string
		dueText : string
		overdue : boolean
		settledText : string
		linkedText : string
	}

	onPageShow(() => {
		if (!session.isLoggedIn) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return
		}
		ensureLoaded()
	})

	const filter = ref('active')
	const settleTargetId = ref('')

	const summary = computed(() => {
		return debtSummary(ledger.debts)
	})

	const netText = computed(() : string => {
		return formatCurrency(summary.value.net, prefs.baseCurrency, prefs.locale)
	})

	const receivableText = computed(() : string => {
		return formatCurrency(summary.value.receivable, prefs.baseCurrency, prefs.locale)
	})

	const payableText = computed(() : string => {
		return formatCurrency(summary.value.payable, prefs.baseCurrency, prefs.locale)
	})

	function countLabel(count : number) : string {
		const unit = t('debts.countUnit')
		return unit.length > 0 ? count.toString() + ' ' + unit : count.toString()
	}

	const receivableCountText = computed(() : string => {
		return countLabel(openDebtCount(ledger.debts, 'receivable'))
	})

	const payableCountText = computed(() : string => {
		return countLabel(openDebtCount(ledger.debts, 'payable'))
	})

	const openCountText = computed(() : string => {
		const count = openDebtCount(ledger.debts, 'receivable') + openDebtCount(ledger.debts, 'payable')
		return count.toString() + ' ' + t('debts.active')
	})

	const activeViews = computed<Array<DebtView>>(() => {
		const result : Array<DebtView> = []
		for (let i = 0; i < ledger.debts.length; i++) {
			const debt = ledger.debts[i]
			if (debt.settled) continue
			result.push(toView(debt))
		}
		return result
	})

	const settledViews = computed<Array<DebtView>>(() => {
		const list : Array<DebtView> = []
		for (let i = 0; i < ledger.debts.length; i++) {
			if (!ledger.debts[i].settled) continue
			list.push(toView(ledger.debts[i]))
		}
		return list
	})

	function toView(debt : Debt) : DebtView {
		const dirLabel = debt.direction == 'receivable' ? t('debts.receivable') : t('debts.payable')
		const settledText = debt.settled
			? t('debts.settledOn') + ' ' + dateLabel(debt.settledAt, prefs.locale)
			: ''
		const linkedText = debt.direction == 'receivable' ? t('debts.generatedIncome') : t('debts.generatedExpense')
		return {
			id: debt.id,
			direction: debt.direction,
			counterparty: debt.counterparty,
			note: debt.note,
			amountText: formatCurrency(debt.amount, debt.currency, prefs.locale),
			dirLabel: dirLabel,
			dueText: debt.settled ? '' : dueLabel(debt.dueDate, prefs.locale),
			overdue: !debt.settled && isOverdue(debt.dueDate),
			settledText: settledText,
			linkedText: linkedText
		}
	}

	const settleTarget = computed<Debt | null>(() => {
		if (settleTargetId.value.length == 0) return null
		return findDebt(settleTargetId.value)
	})

	const settleName = computed(() : string => {
		const debt = settleTarget.value
		if (debt == null) return ''
		return debt.counterparty
	})

	const settleAmountText = computed(() : string => {
		const debt = settleTarget.value
		if (debt == null) return ''
		return formatCurrency(debt.amount, debt.currency, prefs.locale)
	})

	const settleMessage = computed(() : string => {
		const debt = settleTarget.value
		if (debt == null) return ''
		return debt.direction == 'receivable' ? t('debts.settleMsgReceivable') : t('debts.settleMsgPayable')
	})

	function setFilter(value : string) : void {
		filter.value = value
	}

	function addDebt() : void {
		uni.navigateTo({
			url: '/pages/debt-edit/debt-edit'
		})
	}

	function openEdit(id : string) : void {
		uni.navigateTo({
			url: '/pages/debt-edit/debt-edit?id=' + id
		})
	}

	function askSettle(id : string) : void {
		settleTargetId.value = id
	}

	function closeSettle() : void {
		settleTargetId.value = ''
	}

	async function confirmSettle() : Promise<void> {
		const id = settleTargetId.value
		if (id.length == 0) return
		try {
			await settleDebtItem(id)
			settleTargetId.value = ''
			uni.showToast({
				title: t('debts.settleDone'),
				icon: 'success'
			})
		} catch (e) {
			settleTargetId.value = ''
			uni.showModal({
				content: t('common.saveFailed'),
				showCancel: false
			})
		}
	}

	function goBack() : void {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/shell/shell'
				})
			}
		})
	}
</script>

