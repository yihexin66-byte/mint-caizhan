<template>
	<view class="page">
		<aurora-bg level="low" />
		<view class="status-spacer"></view>
		<view class="page-content">
			<view class="topbar enter-fade">
				<view class="icon-btn" @click="goBack">
					<image class="icon-18" src="/static/icons/ui-back-light.png" />
				</view>
				<view class="head-center">
					<text class="page-title">{{ pageTitle }}</text>
					<text class="page-sub">{{ t('debts.subtitle') }}</text>
				</view>
				<view v-if="isEditing && !settled" class="icon-btn" @click="askDelete">
					<image class="icon-18" src="/static/icons/ui-trash-light.png" />
				</view>
				<view v-else class="icon-btn-space"></view>
			</view>

			<view v-if="settled" class="linked-banner enter-rise enter-d1">
				<view class="linked-icon">
					<image class="icon-18" src="/static/icons/ui-shield-light.png" />
				</view>
				<view class="grow">
					<text class="linked-title">{{ t('debts.paid') }}</text>
					<text class="linked-sub">{{ t('debtEdit.linkedHint') }}</text>
				</view>
			</view>

			<view v-if="!settled" class="type-switch enter-rise enter-d1">
				<view :class="direction == 'receivable' ? 'type-item type-item-active' : 'type-item'" @click="setDirection('receivable')">
					<image :class="direction == 'receivable' ? 'type-icon type-icon-active' : 'type-icon'" src="/static/icons/ui-arrow-down-light.png" />
					<text :class="direction == 'receivable' ? 'type-text type-text-active' : 'type-text'">{{ t('debts.receivable') }}</text>
				</view>
				<view :class="direction == 'payable' ? 'type-item type-item-active' : 'type-item'" @click="setDirection('payable')">
					<image :class="direction == 'payable' ? 'type-icon type-icon-active' : 'type-icon'" src="/static/icons/ui-arrow-up-light.png" />
					<text :class="direction == 'payable' ? 'type-text type-text-active' : 'type-text'">{{ t('debts.payable') }}</text>
				</view>
			</view>

			<view class="card party-card enter-rise enter-d2">
				<text class="field-label">{{ t('debtEdit.counterparty') }}</text>
				<view class="party-row">
					<view :class="direction == 'receivable' ? 'party-avatar party-avatar-in' : 'party-avatar party-avatar-out'">
						<text class="party-avatar-text">{{ avatarLetter }}</text>
					</view>
					<input
						class="party-input"
						:value="counterparty"
						:disabled="settled"
						:placeholder="t('debtEdit.counterpartyPh')"
						placeholder-class="party-placeholder"
						@input="onCounterpartyInput"
					/>
				</view>
			</view>

			<view class="amount-card enter-pop enter-d3">
				<view class="amount-orbit"></view>
				<view class="row justify-between items-center">
					<text class="amount-label">{{ t('debtEdit.amount') }}</text>
					<view class="currency-chip" @click="openCurrency">
						<text class="currency-chip-code">{{ currency }}</text>
						<image class="currency-chip-icon" src="/static/icons/ui-down.png" />
					</view>
				</view>
				<view class="row items-end amount-line">
					<text class="amount-symbol">{{ currencySymbol }}</text>
					<input
						class="amount-input"
						type="digit"
						:value="amountText"
						:disabled="settled"
						placeholder="0"
						placeholder-class="amount-placeholder"
						@input="onAmountInput"
					/>
				</view>
				<text class="converted-hint">{{ convertedHint }}</text>
			</view>

			<view class="card detail-card enter-rise enter-d4">
				<picker class="detail-picker" mode="date" :value="dateValue" :disabled="settled" @change="onDateChange">
					<view class="detail-row">
						<view class="detail-icon">
							<image class="icon-18" src="/static/icons/ui-calendar-light.png" />
						</view>
						<text class="detail-label">{{ t('debtEdit.dueDate') }}</text>
						<text class="detail-value">{{ dateDisplay }}</text>
						<image class="detail-arrow" src="/static/icons/ui-right-light.png" />
					</view>
				</picker>
				<view class="divider"></view>
				<view class="detail-row">
					<view class="detail-icon">
						<image class="icon-18" src="/static/icons/ui-edit-light.png" />
					</view>
					<text class="detail-label">{{ t('debtEdit.note') }}</text>
					<input
						class="detail-input"
						:value="note"
						:disabled="settled"
						:placeholder="t('debtEdit.notePh')"
						placeholder-class="detail-placeholder"
						@input="onNoteInput"
					/>
				</view>
			</view>

			<view v-if="!settled" class="btn btn-mint save-btn enter-rise enter-d5" hover-class="pressed" @click="save">
				<image class="save-icon" src="/static/icons/ui-check.png" />
				<text class="btn-mint-text">{{ t('debtEdit.save') }}</text>
			</view>

			<view v-if="isEditing && !settled" class="delete-row" @click="askDelete">
				<image class="delete-icon" src="/static/icons/ui-trash-light.png" />
				<text class="delete-text">{{ t('common.delete') }}</text>
			</view>

			<view class="bottom-space"></view>
		</view>

		<view v-if="currencyOpen" class="modal-mask" @click="closeCurrency">
			<view class="sheet currency-sheet" @click.stop>
				<view class="sheet-handle"></view>
				<text class="sheet-title">{{ t('sheet.currencyTitle') }}</text>
				<view v-for="item in currencies" :key="item.code" class="currency-row" @click="pickCurrency(item.code)">
					<view class="currency-badge">
						<text class="currency-badge-symbol">{{ item.symbol }}</text>
					</view>
					<view class="grow currency-info">
						<text class="currency-name">{{ currencyName(item.code, prefs.locale) }}</text>
						<text class="currency-code">{{ item.code }}</text>
					</view>
					<view v-if="currency == item.code" class="currency-check">
						<image class="currency-check-icon" src="/static/icons/ui-check.png" />
					</view>
				</view>
			</view>
		</view>

		<view v-if="deleteOpen" class="modal-mask modal-mask-center">
			<view class="dialog">
				<view class="dialog-icon">
					<image class="icon-20" src="/static/icons/ui-trash-light.png" />
				</view>
				<text class="dialog-title">{{ t('debtEdit.deleteTitle') }}</text>
				<text class="dialog-msg">{{ t('debtEdit.deleteMsg') }}</text>
				<view class="row dialog-actions">
					<view class="dialog-btn dialog-btn-ghost" @click="closeDelete">
						<text class="dialog-btn-ghost-text">{{ t('common.cancel') }}</text>
					</view>
					<view class="dialog-btn dialog-btn-danger" @click="confirmDelete">
						<text class="dialog-btn-danger-text">{{ t('common.delete') }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref, watch } from 'vue'
	import AuroraBg from '@/components/aurora-bg.uvue'
	import { t } from '@/i18n/index.uts'
	import { prefs } from '@/stores/prefs.uts'
	import { session } from '@/stores/session.uts'
	import { ledger, ensureLoaded, findDebt, saveDebtItem, removeDebtItem } from '@/stores/ledger.uts'
	import { CurrencyDef, Debt, DebtInput } from '@/types/models.uts'
	import { CURRENCIES, currencyByCode, currencyName } from '@/constants/currencies.uts'
	import { dateLabelWithWeek, nextDaysTs, parseDateInput, toDateInput } from '@/utils/date.uts'
	import { convertAmount, formatCurrency, parseAmount, trimAmountInput } from '@/utils/money.uts'

	const direction = ref('receivable')
	const counterparty = ref('')
	const amountText = ref('')
	const currency = ref(prefs.baseCurrency)
	const dueTs = ref(nextDaysTs(14))
	const note = ref('')
	const editId = ref('')
	const hydrated = ref(false)
	const currencyOpen = ref(false)
	const deleteOpen = ref(false)

	const currencies = computed<Array<CurrencyDef>>(() => {
		return CURRENCIES
	})

	const currentDebt = computed<Debt | null>(() => {
		if (editId.value.length == 0) return null
		return findDebt(editId.value)
	})

	const isEditing = computed(() : boolean => {
		return editId.value.length > 0
	})

	const settled = computed(() : boolean => {
		const debt = currentDebt.value
		if (debt == null) return false
		return debt.settled
	})

	const pageTitle = computed(() : string => {
		return isEditing.value ? t('debtEdit.editTitle') : t('debtEdit.newTitle')
	})

	const avatarLetter = computed(() : string => {
		if (counterparty.value.length == 0) return '·'
		return counterparty.value.substring(0, 1).toUpperCase()
	})

	const currencySymbol = computed(() : string => {
		return currencyByCode(currency.value).symbol
	})

	const dateValue = computed(() : string => {
		return toDateInput(dueTs.value)
	})

	const dateDisplay = computed(() : string => {
		return dateLabelWithWeek(dueTs.value, prefs.locale)
	})

	const convertedHint = computed(() : string => {
		const amount = parseAmount(amountText.value)
		if (amount <= 0) return t('recordEdit.currencyHint')
		if (currency.value == prefs.baseCurrency) return t('recordEdit.currencyHint')
		const converted = convertAmount(amount, currency.value, prefs.baseCurrency, prefs.rates)
		return t('recordEdit.converted') + ' ' + formatCurrency(converted, prefs.baseCurrency, prefs.locale) + ' ' + prefs.baseCurrency
	})

	onLoad((options : OnLoadOptions) => {
		const raw = options.getString('id')
		if (raw != null && raw.length > 0) {
			editId.value = raw
		}
	})

	onPageShow(() => {
		if (!session.isLoggedIn) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return
		}
		ensureLoaded()
		hydrate()
	})

	onMounted(() => {
		hydrate()
	})

	watch(() => ledger.loaded, (loaded : boolean) => {
		if (loaded) hydrate()
	})

	function hydrate() : void {
		if (hydrated.value) return
		if (editId.value.length == 0) {
			hydrated.value = true
			return
		}
		if (!ledger.loaded) return
		const debt = findDebt(editId.value)
		if (debt != null) {
			direction.value = debt.direction
			counterparty.value = debt.counterparty
			amountText.value = trimAmountInput(debt.amount.toString())
			currency.value = debt.currency
			dueTs.value = debt.dueDate
			note.value = debt.note
		}
		hydrated.value = true
	}

	function setDirection(value : string) : void {
		if (settled.value) return
		direction.value = value
	}

	function onCounterpartyInput(event : UniInputEvent) : void {
		counterparty.value = event.detail.value
	}

	function onAmountInput(event : UniInputEvent) : void {
		amountText.value = trimAmountInput(event.detail.value)
	}

	function onNoteInput(event : UniInputEvent) : void {
		note.value = event.detail.value
	}

	function onDateChange(event : UniPickerChangeEvent) : void {
		dueTs.value = parseDateInput(event.detail.value as string)
	}

	function openCurrency() : void {
		if (settled.value) return
		currencyOpen.value = true
	}

	function closeCurrency() : void {
		currencyOpen.value = false
	}

	function pickCurrency(code : string) : void {
		currency.value = code
		currencyOpen.value = false
	}

	async function save() : Promise<void> {
		if (settled.value) return
		if (counterparty.value.length == 0) {
			uni.showToast({
				title: t('debtEdit.validationName'),
				icon: 'none'
			})
			return
		}
		const amount = parseAmount(amountText.value)
		if (amount <= 0) {
			uni.showToast({
				title: t('debtEdit.validationAmount'),
				icon: 'none'
			})
			return
		}
		const input : DebtInput = {
			id: editId.value,
			direction: direction.value,
			counterparty: counterparty.value,
			amount: amount,
			currency: currency.value,
			dueDate: dueTs.value,
			note: note.value
		}
		try {
			await saveDebtItem(input)
			uni.showToast({
				title: t('debtEdit.saved'),
				icon: 'success'
			})
			setTimeout(() => {
				uni.navigateBack({
					delta: 1
				})
			}, 380)
		} catch (e) {
			uni.showModal({
				content: t('common.saveFailed'),
				showCancel: false
			})
		}
	}

	function askDelete() : void {
		if (settled.value) {
			uni.showToast({
				title: t('debts.deleteBlocked'),
				icon: 'none'
			})
			return
		}
		deleteOpen.value = true
	}

	function closeDelete() : void {
		deleteOpen.value = false
	}

	async function confirmDelete() : Promise<void> {
		const id = editId.value
		deleteOpen.value = false
		if (id.length == 0) return
		try {
			await removeDebtItem(id)
			uni.navigateBack({
				delta: 1
			})
		} catch (e) {
			uni.showModal({
				content: t('common.deleteFailed'),
				showCancel: false
			})
		}
	}

	function goBack() : void {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/shell/shell'
				})
			}
		})
	}
</script>

