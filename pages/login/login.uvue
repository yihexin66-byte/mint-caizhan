		<view class="login-action enter-rise enter-d4">
			<view class="btn btn-mint login-btn" hover-class="pressed" @click="handleLogin">
				<!-- #ifdef WEB -->
				<text class="login-btn-text">{{ loading ? t('login.loading') : t('login.demo') }}</text>
				<!-- #endif -->
				<!-- #ifndef WEB -->
				<text class="login-btn-text">{{ loading ? t('login.loading') : t('login.wechat') }}</text>
				<!-- #endif -->
			</view>
			<text class="login-agreement">{{ t('login.agreement') }}</text>
			<!-- #ifdef WEB -->
			<text class="login-demo-note">{{ t('login.localHint') }}</text>
			<!-- #endif -->
		</view>
