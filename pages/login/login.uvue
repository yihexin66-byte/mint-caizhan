	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import AuroraBg from '@/components/aurora-bg.uvue'
	import { t } from '@/i18n/index.uts'
	import { prefs, setLocale } from '@/stores/prefs.uts'
	import { applyLogin } from '@/stores/session.uts'
	import { login } from '@/services/api.uts'

	const loading = ref(false)

	function chooseLocale(locale : string) : void {
		setLocale(locale)
	}

	function handleLogin() : void {
		if (loading.value) return
		loading.value = true
		// #ifdef WEB
		performLogin('web-demo')
		// #endif
		// #ifdef MP-WEIXIN
		uni.login({
			provider: 'weixin',
			success: (res) => {
				performLogin(res.code)
			},
			fail: (_) => {
				loading.value = false
				uni.showToast({
					title: t('login.failed'),
					icon: 'none'
				})
			}
		})
		// #endif
	}

	async function performLogin(code : string) : Promise<void> {
		try {
			const result = await login(code)
			applyLogin(result)
			loading.value = false
			uni.reLaunch({
				url: '/pages/shell/shell'
			})
		} catch (e) {
			loading.value = false
			let message = t('login.failed')
			if (e != null) {
				const err = e as Error
				const raw = err.message
				if (raw.indexOf('AppSecret') >= 0 || raw.indexOf('APP_SECRET') >= 0) {
					message = t('login.secretMissing')
				} else if (raw.length > 0) {
					message = raw
				}
			}
			uni.showModal({
				title: t('login.failed'),
				content: message,
				showCancel: false,
				confirmText: t('common.done')
			})
		}
	}
</script>

