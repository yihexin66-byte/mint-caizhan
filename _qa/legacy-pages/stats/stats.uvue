<template>
	<view class="page">
		<aurora-bg level="high" />
		<view class="status-spacer"></view>
		<view class="page-content">
			<view class="topbar enter-fade">
				<view class="head-left">
					<text class="page-title">{{ t('stats.title') }}</text>
					<text class="page-sub">{{ t('stats.subtitle') }}</text>
				</view>
				<view class="rate-pill">
					<image class="rate-pill-icon" src="/static/icons/ui-swap-light.png" />
					<text class="rate-pill-text">{{ t('stats.rateNote') }}</text>
				</view>
			</view>

			<view class="row justify-between items-center month-row enter-rise enter-d1">
				<month-switch :label="monthTitle" @prev="prevMonth" @next="nextMonth" />
				<view class="section-count">
					<text class="section-count-text">{{ t('stats.allMonths') }}</text>
				</view>
			</view>

			<view v-if="!ledger.loaded" class="loading-wrap">
				<image class="logo-40" src="/static/icons/logo-light.png" />
				<text class="loading-text">{{ ledger.error.length > 0 ? t('common.networkError') : t('common.loading') }}</text>
			</view>

			<view v-else>
				<view class="card hero-card enter-pop enter-d2">
					<view class="row hero-row">
						<view class="donut-holder">
							<donut-chart
								:segments="segments"
								:size="158"
								:thickness="16"
								:center-value="donutCenterValue"
								:center-label="donutCenterLabel"
							/>
						</view>
						<view class="hero-right">
							<text class="hero-label">{{ t('stats.expenseTotal') }}</text>
							<view class="row items-end hero-amount-line">
								<text class="hero-amount">{{ heroExpenseAmountText }}</text>
								<text class="hero-currency">{{ prefs.baseCurrency }}</text>
							</view>

							<view class="hero-divider"></view>

							<view class="row items-center hero-stat">
								<view class="dot dot-mint"></view>
								<text class="hero-stat-label">{{ t('stats.income') }}</text>
								<text class="hero-stat-value amount-pos">{{ incomeText }}</text>
							</view>
							<view class="row items-center hero-stat">
								<view class="dot dot-ink"></view>
								<text class="hero-stat-label">{{ t('stats.net') }}</text>
								<text class="hero-stat-value">{{ netText }}</text>
							</view>

							<view class="saving-pill">
								<text class="saving-pill-text">{{ t('stats.savings') }} {{ savingsText }}</text>
							</view>
						</view>
					</view>
				</view>

				<view class="section-header enter-rise enter-d3">
					<view>
						<text class="section-title">{{ t('stats.byCategory') }}</text>
						<text class="section-sub">{{ categoryCountText }}</text>
					</view>
					<view class="legend-caption">
						<view class="dot dot-orange"></view>
						<text class="legend-caption-text">{{ t('stats.percentOfSpend') }}</text>
					</view>
				</view>

				<view v-if="legend.length == 0" class="mt-8">
					<empty-state
						:title="t('stats.noData')"
						:subtitle="t('stats.noDataSub')"
						:action="t('home.add')"
						icon="/static/icons/logo-light.png"
						@action="addEntry"
					/>
				</view>

				<view v-else class="card legend-card enter-rise enter-d4">
					<view v-for="(item, index) in legend" :key="item.categoryId">
						<view class="legend-row">
							<view class="row items-center">
								<view class="legend-dot" :style="'background-color: ' + item.color"></view>
								<text class="legend-name">{{ item.name }}</text>
								<text class="legend-percent">{{ item.percentText }}</text>
								<text class="legend-amount">{{ item.amountText }}</text>
							</view>
							<view class="legend-track">
								<view class="legend-fill" :style="'width: ' + item.width + '%; background-color: ' + item.color"></view>
							</view>
						</view>
						<view v-if="index < legend.length - 1" class="legend-gap"></view>
					</view>
				</view>

				<view class="card trend-card enter-rise enter-d5">
					<view class="row justify-between items-center">
						<view>
							<text class="section-title">{{ t('stats.trend') }}</text>
							<text class="section-sub">{{ t('stats.trendSub') }}</text>
						</view>
						<view class="row items-center">
							<view class="row items-center trend-legend">
								<view class="dot dot-mint"></view>
								<text class="trend-legend-text">{{ t('stats.income') }}</text>
							</view>
							<view class="row items-center trend-legend trend-legend-last">
								<view class="dot dot-orange"></view>
								<text class="trend-legend-text">{{ t('stats.expense') }}</text>
							</view>
						</view>
					</view>
					<view class="mt-10">
						<trend-chart :months="months" />
					</view>
				</view>

				<view class="section-header enter-rise enter-d3">
					<view>
						<text class="section-title">{{ t('stats.insights') }}</text>
						<text class="section-sub">{{ monthTitle }}</text>
					</view>
				</view>

				<view class="row wrap insight-grid enter-rise enter-d5">
					<view v-for="(item, index) in insights" :key="item.key" :class="index % 2 == 0 ? 'insight-card insight-card-left' : 'insight-card'">
						<view class="insight-icon">
							<image class="icon-18" :src="item.icon" />
						</view>
						<text class="insight-label">{{ item.label }}</text>
						<text class="insight-value">{{ item.value }}</text>
						<text class="insight-sub">{{ item.sub }}</text>
					</view>
				</view>

				<view class="tabbar-space"></view>
			</view>
		</view>

		<app-tabbar active="stats" />
	</view>
</template>

<script setup lang="uts">
	import { computed, ref, watch } from 'vue'
	import AppTabbar from '@/components/app-tabbar.uvue'
	import AuroraBg from '@/components/aurora-bg.uvue'
	import MonthSwitch from '@/components/month-switch.uvue'
	import DonutChart from '@/components/donut-chart.uvue'
	import TrendChart from '@/components/trend-chart.uvue'
	import EmptyState from '@/components/empty-state.uvue'
	import { t } from '@/i18n/index.uts'
	import { prefs } from '@/stores/prefs.uts'
	import { session } from '@/stores/session.uts'
	import { ledger, ensureLoaded, setMonth } from '@/stores/ledger.uts'
	import {
		categoryStats,
		dailyAverage,
		largestExpense,
		monthSummary,
		monthlySeries
	} from '@/utils/stats.uts'
	import { addMonthsKey, monthLabel } from '@/utils/date.uts'
	import { formatCurrency, formatPercent } from '@/utils/money.uts'
	import { categoryById, categoryName } from '@/constants/categories.uts'
	import { ChartSegment, MonthStat, Transaction } from '@/types/models.uts'

	type LegendView = {
		categoryId : string
		name : string
		color : string
		percentText : string
		amountText : string
		width : number
	}

	type InsightView = {
		key : string
		label : string
		value : string
		sub : string
		icon : string
	}

	onPageShow(() => {
		if (!session.isLoggedIn) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return
		}
		ensureLoaded()
		if (ledger.loaded) animateExpense()
	})

	const monthTitle = computed(() : string => {
		return monthLabel(ledger.currentMonth, prefs.locale)
	})

	const summary = computed(() => {
		return monthSummary(ledger.transactions, ledger.currentMonth)
	})

	const expenseAmountText = computed(() : string => {
		return formatCurrency(summary.value.expense, prefs.baseCurrency, prefs.locale)
	})

	const animExpense = ref(0)
	let statsCountToken = 0

	const heroExpenseAmountText = computed(() : string => {
		return formatCurrency(animExpense.value, prefs.baseCurrency, prefs.locale)
	})

	function animateExpense() : void {
		const target = summary.value.expense
		const from = animExpense.value
		statsCountToken = statsCountToken + 1
		const token = statsCountToken
		const started = Date.now()
		const step = () : void => {
			if (token != statsCountToken) return
			let progress = (Date.now() - started) / 760
			if (progress > 1) progress = 1
			const eased = 1 - Math.pow(1 - progress, 3)
			animExpense.value = from + (target - from) * eased
			if (progress < 1) {
				setTimeout(step, 32)
			}
		}
		step()
	}

	watch(() => ledger.loaded, (_value) => {
		if (ledger.loaded) animateExpense()
	})

	watch(() => ledger.currentMonth, (_value) => {
		if (ledger.loaded) animateExpense()
	})

	const incomeText = computed(() : string => {
		return formatCurrency(summary.value.income, prefs.baseCurrency, prefs.locale)
	})

	const netText = computed(() : string => {
		return formatCurrency(summary.value.balance, prefs.baseCurrency, prefs.locale)
	})

	const savingsRate = computed(() : number => {
		if (summary.value.income <= 0) return 0
		return summary.value.balance / summary.value.income * 100
	})

	const savingsText = computed(() : string => {
		return formatPercent(savingsRate.value)
	})

	const catStats = computed(() => {
		return categoryStats(ledger.transactions, ledger.currentMonth)
	})

	const categoryCountText = computed(() : string => {
		return catStats.value.length.toString() + ' ' + t('stats.categories')
	})

	const segments = computed<Array<ChartSegment>>(() => {
		const result : Array<ChartSegment> = []
		const stats = catStats.value
		let otherValue = 0
		for (let i = 0; i < stats.length; i++) {
			if (i < 5) {
				const cat = categoryById(stats[i].categoryId)
				const name = prefs.locale == 'en' ? cat.nameEn : cat.nameZh
				result.push({ label: name, value: stats[i].amount, color: cat.color })
			} else {
				otherValue += stats[i].amount
			}
		}
		if (otherValue > 0) {
			result.push({ label: t('stats.other'), value: otherValue, color: '#7E8B84' })
		}
		return result
	})

	const legend = computed<Array<LegendView>>(() => {
		const result : Array<LegendView> = []
		const stats = catStats.value
		const total = summary.value.expense
		if (total <= 0) return result
		let otherValue = 0
		for (let i = 0; i < stats.length; i++) {
			const item = stats[i]
			if (i < 5) {
				const cat = categoryById(item.categoryId)
				const pct = item.amount / total * 100
				result.push({
					categoryId: item.categoryId,
					name: prefs.locale == 'en' ? cat.nameEn : cat.nameZh,
					color: cat.color,
					percentText: formatPercent(pct),
					amountText: formatCurrency(item.amount, prefs.baseCurrency, prefs.locale),
					width: pct > 100 ? 100 : (pct < 2 ? 2 : pct)
				})
			} else {
				otherValue += item.amount
			}
		}
		if (otherValue > 0) {
			const pct = otherValue / total * 100
			result.push({
				categoryId: 'others',
				name: t('stats.other'),
				color: '#7E8B84',
				percentText: formatPercent(pct),
				amountText: formatCurrency(otherValue, prefs.baseCurrency, prefs.locale),
				width: pct > 100 ? 100 : (pct < 2 ? 2 : pct)
			})
		}
		return result
	})

	const months = computed<Array<MonthStat>>(() => {
		return monthlySeries(ledger.transactions, ledger.currentMonth, 6)
	})

	const topCategory = computed(() => {
		if (catStats.value.length == 0) return null
		return catStats.value[0]
	})

	const donutCenterValue = computed(() : string => {
		const first = topCategory.value
		if (first == null || summary.value.expense <= 0) return '0%'
		return formatPercent(first.amount / summary.value.expense * 100)
	})

	const donutCenterLabel = computed(() : string => {
		const first = topCategory.value
		if (first == null) return t('stats.donutCenter')
		return categoryName(first.categoryId, prefs.locale)
	})

	const topCategoryText = computed(() : string => {
		const first = topCategory.value
		if (first == null) return t('stats.noLargest')
		return categoryName(first.categoryId, prefs.locale)
	})

	const topCategorySub = computed(() : string => {
		const first = topCategory.value
		if (first == null || summary.value.expense <= 0) return t('stats.noLargest')
		const pct = first.amount / summary.value.expense * 100
		return formatPercent(pct) + ' ' + t('stats.percentOfSpend')
	})

	const dailyAverageText = computed(() : string => {
		return formatCurrency(dailyAverage(ledger.transactions, ledger.currentMonth), prefs.baseCurrency, prefs.locale)
	})

	const largest = computed<Transaction | null>(() => {
		return largestExpense(ledger.transactions, ledger.currentMonth)
	})

	const largestText = computed(() : string => {
		const item = largest.value
		if (item == null) return t('stats.noLargest')
		return formatCurrency(item.amount, item.currency, prefs.locale)
	})

	const largestSub = computed(() : string => {
		const item = largest.value
		if (item == null) return ''
		return categoryName(item.categoryId, prefs.locale)
	})

	const insights = computed<Array<InsightView>>(() => {
		const result : Array<InsightView> = []
		result.push({
			key: 'savings',
			label: t('stats.savings'),
			value: savingsText.value,
			sub: t('stats.net') + ' ' + netText.value,
			icon: '/static/icons/ui-wallet-light.png'
		})
		result.push({
			key: 'daily',
			label: t('stats.avgDaily'),
			value: dailyAverageText.value,
			sub: t('stats.rateNote'),
			icon: '/static/icons/ui-calendar-light.png'
		})
		result.push({
			key: 'largest',
			label: t('stats.largest'),
			value: largestText.value,
			sub: largestSub.value,
			icon: '/static/icons/ui-arrow-up-light.png'
		})
		result.push({
			key: 'top',
			label: t('stats.topCategory'),
			value: topCategoryText.value,
			sub: topCategorySub.value,
			icon: '/static/icons/ui-sparkles-light.png'
		})
		return result
	})

	function prevMonth() : void {
		setMonth(addMonthsKey(ledger.currentMonth, -1))
	}

	function nextMonth() : void {
		setMonth(addMonthsKey(ledger.currentMonth, 1))
	}

	function addEntry() : void {
		uni.navigateTo({
			url: '/pages/record-edit/record-edit'
		})
	}
</script>

<style>
	.topbar {
		padding-top: 2px;
		padding-bottom: 2px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.head-left {
		flex-direction: column;
	}

	.page-title {
		font-size: 27px;
