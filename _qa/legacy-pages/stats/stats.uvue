		flex: 1;
		flex-direction: column;
		margin-left: 16px;
	}

	.hero-label {
		font-size: 10px;
		color: rgba(234,242,237,0.56);
	}

	.hero-amount-line {
		margin-top: 4px;
	}

	.hero-amount {
		font-size: 24px;
		font-weight: 800;
		color: #F2F6F1;
		letter-spacing: -0.8px;
	}

	.hero-currency {
		font-size: 9px;
		color: rgba(234,242,237,0.40);
		margin-left: 4px;
		margin-bottom: 3px;
	}

	.hero-divider {
		height: 1px;
		background-color: rgba(255,255,255,0.08);
		margin-top: 10px;
		margin-bottom: 9px;
	}

	.hero-stat {
		margin-bottom: 6px;
	}

	.hero-stat-label {
		font-size: 10px;
		color: rgba(234,242,237,0.56);
		margin-left: 6px;
	}

	.hero-stat-value {
		font-size: 11px;
		font-weight: 700;
		color: #F2F6F1;
		margin-left: auto;
	}

	.dot-ink {
		background-color: rgba(245,247,244,0.55);
	}

	.saving-pill {
		height: 24px;
		border-radius: 12px;
		background-color: rgba(123,231,191,0.12);
		padding-left: 9px;
		padding-right: 9px;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		margin-top: 3px;
		box-shadow: inset 0 0 0 1px rgba(169,237,203,0.16);
	}

	.saving-pill-text {
		font-size: 9px;
		font-weight: 700;
		color: #8FE3BC;
	}

	.section-header {
		margin-top: 20px;
		margin-bottom: 9px;
		padding-left: 4px;
		padding-right: 4px;
		flex-direction: row;
		align-items: flex-end;
		justify-content: space-between;
	}

	.section-title {
		font-size: 16px;
		font-weight: 750;
		color: #F2F6F1;
	}

	.section-sub {
		font-size: 11px;
		color: rgba(234,242,237,0.42);
		margin-top: 3px;
	}

	.legend-caption {
		flex-direction: row;
		align-items: center;
	}

	.legend-caption-text {
		font-size: 9px;
		color: rgba(234,242,237,0.42);
		margin-left: 5px;
	}

	.legend-card {
		padding: 16px;
	}

	.legend-row {
		flex-direction: column;
	}

	.legend-dot {
		width: 8px;
		height: 8px;
		border-radius: 4px;
	}

	.legend-name {
		font-size: 12px;
		font-weight: 650;
