		margin-left: 8px;
	}

	.legend-percent {
		font-size: 10px;
		color: rgba(234,242,237,0.42);
		margin-left: auto;
		margin-right: 10px;
	}

	.legend-amount {
		font-size: 12px;
		font-weight: 700;
		color: #F2F6F1;
		min-width: 52px;
		text-align: right;
	}

	.legend-track {
		height: 5px;
		border-radius: 3px;
		background-color: rgba(255,255,255,0.08);
		overflow: hidden;
		margin-top: 7px;
	}

	.legend-fill {
		height: 5px;
		border-radius: 3px;
		transform-origin: 0 50%;
		animation-name: mintGrowX;
		animation-duration: 620ms;
		animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
		animation-fill-mode: backwards;
		animation-delay: 260ms;
	}

	.legend-gap {
		height: 13px;
	}

	.trend-card {
		margin-top: 14px;
		padding: 17px 16px 10px 16px;
	}

	.trend-legend {
		margin-left: 10px;
	}

	.trend-legend-last {
		margin-left: 12px;
	}

	.trend-legend-text {
		font-size: 9px;
		color: rgba(234,242,237,0.52);
		margin-left: 4px;
	}

	.insight-grid {
		flex-direction: row;
	}

	.insight-card {
		width: calc(50% - 5px);
		background-color: rgba(255,255,255,0.045);
		background-image: linear-gradient(150deg, rgba(255,255,255,0.10) 0%, rgba(255,255,255,0.025) 52%, rgba(255,255,255,0.055) 100%);
		border-radius: 21px;
		padding: 14px;
		margin-bottom: 10px;
		box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08), inset 0 1px 0 rgba(255,255,255,0.16), 0 12px 28px rgba(0,0,0,0.40);
		flex-direction: column;
	}

	.insight-card-left {
		margin-right: 10px;
	}

	.insight-icon {
		width: 32px;
		height: 32px;
		border-radius: 10px;
		background-color: rgba(255,255,255,0.06);
		align-items: center;
		justify-content: center;
	}

	.insight-label {
		font-size: 10px;
		color: rgba(234,242,237,0.52);
		margin-top: 10px;
	}

	.insight-value {
		font-size: 16px;
		font-weight: 750;
		color: #F2F6F1;
		margin-top: 3px;
		letter-spacing: -0.3px;
	}

	.insight-sub {
		font-size: 9px;
		color: rgba(234,242,237,0.38);
		margin-top: 4px;
		line-height: 13px;
	}

	.loading-text {
		font-size: 12px;
		color: rgba(234,242,237,0.46);
		margin-top: 14px;
	}
</style>
