		background-color: rgba(17,24,20,0.64);
		background-image: radial-gradient(125% 120% at 96% -14%, rgba(123,231,191,0.22) 0%, rgba(123,231,191,0.06) 44%, rgba(255,255,255,0.02) 70%, rgba(255,255,255,0.05) 100%);
		box-shadow: inset 0 0 0 1px rgba(169,237,203,0.16), inset 0 1px 0 rgba(255,255,255,0.22), 0 22px 48px rgba(0,0,0,0.48);
	}

	.hero-row {
		align-items: center;
	}

	.donut-holder {
		width: 158px;
		height: 158px;
	}

