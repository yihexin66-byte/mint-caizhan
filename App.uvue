		to {
			transform: scaleX(1);
		}
	}

	@keyframes mintGrowY {
		from {
			transform: scaleY(0);
		}
		to {
			transform: scaleY(1);
		}
	}

	@keyframes mintSheetUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes mintDialogIn {
		from {
