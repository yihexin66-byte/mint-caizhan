<script setup lang="uts">
	import { initPrefs } from '@/stores/prefs.uts'
	import { restoreSession, resolveAvatar, enableDemoSession } from '@/stores/session.uts'

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		initPrefs()
		restoreSession()
		resolveAvatar()
		// #ifdef WEB
		// 浏览器端连接演示数据，方便预览全部界面；正式小程序走 uniCloud。
		enableDemoSession()
		// #endif
	})

	onAppShow(() => {
		console.log('Mint app show')
	})

	onAppHide(() => {
		console.log('Mint app hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			uni.exit()
		}
	})
	// #endif
</script>

<style>
